{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-skills.dev/schemas/agent-orchestration.schema.json",
  "title": "AgentOrchestration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "setSlug",
    "source",
    "allowedRuntimes",
    "controlPlane",
    "capabilities",
    "defaultProfile",
    "runtimeDefaults"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "setSlug": {
      "type": "string",
      "pattern": "^agent-set:[a-z0-9][a-z0-9-]{1,47}$"
    },
    "source": { "const": "project-local" },
    "allowedRuntimes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["director", "orchestrator", "compatibilityWorker"],
      "properties": {
        "director": { "type": ["string", "null"], "minLength": 2, "maxLength": 64 },
        "orchestrator": { "type": "string", "minLength": 2, "maxLength": 64 },
        "compatibilityWorker": { "type": ["string", "null"], "minLength": 2, "maxLength": 64 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "implementation",
        "diagnosis",
        "verification",
        "surgical",
        "research",
        "gate-run"
      ],
      "properties": {
        "architecture": { "type": "string", "minLength": 2, "maxLength": 64 },
        "implementation": { "type": "string", "minLength": 2, "maxLength": 64 },
        "diagnosis": { "type": "string", "minLength": 2, "maxLength": 64 },
        "verification": { "type": "string", "minLength": 2, "maxLength": 64 },
        "surgical": { "type": "string", "minLength": 2, "maxLength": 64 },
        "research": { "type": "string", "minLength": 2, "maxLength": 64 },
        "gate-run": { "type": "string", "minLength": 2, "maxLength": 64 }
      }
    },
    "defaultProfile": {
      "type": ["string", "null"],
      "pattern": "^swarm-profile:[a-z0-9][a-z0-9-]{1,47}$"
    },
    "runtimeDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort"],
          "properties": {
            "model": { "type": "string", "minLength": 2, "maxLength": 128 },
            "effort": { "enum": ["low", "medium", "high", "xhigh"] }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort"],
          "properties": {
            "model": { "type": "string", "minLength": 2, "maxLength": 128 },
            "effort": { "enum": ["low", "medium", "high", "xhigh"] }
          }
        }
      }
    }
  }
}
